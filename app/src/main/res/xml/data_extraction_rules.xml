<?xml version="1.0" encoding="utf-8"?>
<!--
  Roadguard is privacy-first: recordings, GPS tracks, settings and diagnostics never leave
  the device. Cloud backup and device-to-device transfer are therefore fully disabled
  rather than filtered, so no video, location or configuration data can be copied off the
  phone by the platform's backup machinery.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="false">
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
